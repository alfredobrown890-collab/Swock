PORT=8080
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-before-deployment
DB_FILE=./data/devmanagement.sqlite

# Values displayed in the panel and embedded in issued Swock profile URIs.
VPN_SERVER_NAME=Swock VPN
VPN_SERVER_HOST=your-vps-hostname
VPN_SERVER_PUBLIC_KEY=replace-with-64-character-server-public-key
VPN_ALLOWED_KEYS_FILE=./data/allowed-client-keys
VPN_TCP_PORT=8505
VPN_WS_PORT=801
VPN_TLS_PORT=8443
VPN_WSS_PORT=9443
VPN_TLS_SNI=
VPN_WS_PATH=/
VPN_WS_HOST=
