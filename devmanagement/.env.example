# Optional manual/local development configuration only.
# The VPS installer does not read or copy this file. It prompts for production
# values and writes /etc/swock-devmanagement.env with the matching tunnel ports.
# Keep these ports aligned with the corresponding swock-server listen flags.
PORT=8080
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-local-development-password
DB_FILE=./data/devmanagement.sqlite

# Values displayed in the panel and embedded in issued Swock profile URIs.
VPN_SERVER_NAME=Swock VPN
VPN_SERVER_HOST=your-vps-hostname
VPN_SERVER_PUBLIC_KEY=replace-with-64-character-server-public-key
VPN_ALLOWED_KEYS_FILE=./data/allowed-client-keys
# Set every port to the corresponding listener configured on your local server.
VPN_TCP_PORT=
VPN_WS_PORT=
VPN_TLS_PORT=
VPN_WSS_PORT=
VPN_TLS_SNI=
VPN_WS_PATH=/
VPN_WS_HOST=
